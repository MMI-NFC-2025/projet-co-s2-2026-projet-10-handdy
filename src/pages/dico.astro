---
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SignCard from '../components/SignCard.astro';
import VideoModal from '../components/VideoModal.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo_wendy.svg';
import iconeDico from '../assets/image22.svg';


// Récupération des icônes
import iconePolitesse from '../assets/icone_politesse.svg';
import iconeEmotions from '../assets/icone_emotions.svg';
import iconeAlimentation from '../assets/icone_pomme.svg';
import iconeFamille from '../assets/icone_famille.svg';
import iconeVerbes from '../assets/icone_casque.svg';
import iconeQuotidien from '../assets/icone_arbre.svg';

const POCKETBASE_URL = 'http://127.0.0.1:8090/api';

interface Sign {
  id: string;
  nom: string;
  description?: string;
  video?: string;
  miniature?: string;
  thematics?: string | string[];
  collectionId?: string;
}

interface Category {
  id: string;
  nom: string;
  icon: any;
  keywords: string[];
}

const categories: Category[] = [
  { id: 'politesse', nom: 'Politesse', icon: iconePolitesse, keywords: ['politesse', 'bonjour', 'merci', 'aurevoir', 'bonsoir', "s'il vous plaît"] },
  { id: 'emotions', nom: 'Emotions', icon: iconeEmotions, keywords: ['emotion', 'heureux', 'triste', 'colère', 'peur', 'joie'] },
  { id: 'alimentation', nom: 'Alimentation', icon: iconeAlimentation, keywords: ['manger', 'boire', 'nourriture', 'repas', 'faim', 'soif'] },
  { id: 'famille', nom: 'Famille', icon: iconeFamille, keywords: ['maman', 'papa', 'frère', 'soeur', 'enfant', 'parent', 'famille', 'homme', 'femme'] },
  { id: 'verbes', nom: 'Verbes', icon: iconeVerbes, keywords: ['faire', 'aller', 'venir', 'avoir', 'être', 'pouvoir', 'vouloir', 'dormir', 'travailler', 'apprendre'] },
  { id: 'quotidien', nom: 'Quotidien', icon: iconeQuotidien, keywords: ['jour', "aujourd'hui", 'hier', 'demain', 'temps', 'heure', 'semaine', 'lentement', 'rapidement'] },
];

function categorizeSign(sign: Sign): string {
  const signName = (sign.nom || '').toLowerCase();
  for (const category of categories) {
    for (const keyword of category.keywords) {
      if (signName.includes(keyword.toLowerCase())) return category.id;
    }
  }
  return 'quotidien';
}

function getImageUrl(sign: Sign, baseUrl: string = POCKETBASE_URL): string {
  if (sign.miniature && sign.collectionId) {
    return `${baseUrl}/files/${sign.collectionId}/${sign.id}/${sign.miniature}`;
  }
  return '';
}

function getVideoUrl(sign: Sign, baseUrl: string = POCKETBASE_URL): string {
  if (sign.video && sign.collectionId) {
    return `${baseUrl}/files/${sign.collectionId}/${sign.id}/${sign.video}`;
  }
  return '';
}

let signs: Sign[] = [];
let signCategories: Map<string, string> = new Map();
let error: string | null = null;

try {
  const signsResponse = await fetch(`${POCKETBASE_URL}/collections/signs/records?perPage=500`);
  if (!signsResponse.ok) throw new Error(`Erreur ${signsResponse.status}`);
  const signsData = await signsResponse.json();
  signs = signsData.items || [];
  
  signs.forEach((sign) => {
    signCategories.set(sign.id, categorizeSign(sign));
  });
} catch (err) {
  error = err instanceof Error ? err.message : 'Erreur inconnue';
}
---

<Layout title="Dictionnaire LSF - Wenddy">
  <div class="min-h-screen bg-[#F3F4F6] flex flex-col font-sans overflow-x-hidden">
    
    <header class="bg-[#FF6200] rounded-b-[2rem] md:rounded-b-[3rem] pt-6 pb-12 px-6 md:px-12 shadow-sm relative z-20">
      <div class="max-w-7xl mx-auto flex flex-col gap-8">
        
        <div class="flex justify-between items-center">
          <a href="/">
            <img src={logo.src} alt="Wenddy" class="h-10 md:h-14 w-auto" />
          </a>
          <button class="text-black hover:opacity-70 transition">
            <svg class="w-8 h-8 md:w-10 md:h-10" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>

        <h1 class="text-white text-3xl md:text-5xl lg:text-6xl font-black font-cal-sans flex items-center gap-3">
          Dictionnaire LSF 
          <img src={iconeDico.src} alt="Icône dictionnaire" class="w-10 h-10 md:w-16 md:h-16 object-contain" />
        </h1>
        
      </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-6 py-10 md:py-16">
      
      <div class="w-full mb-12 md:mb-16">
        <div class="bg-white rounded-full flex items-center px-6 py-4 md:py-5 shadow-sm border border-gray-200 focus-within:ring-2 focus-within:ring-[#FF6200] transition-all">
          <svg class="w-6 h-6 text-gray-400 mr-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            id="dico-search-input"
            placeholder="Recherchez un signe" 
            class="w-full bg-transparent outline-none text-slate-900 font-alexandria placeholder:text-gray-400 text-lg md:text-xl" 
          />
        </div>
      </div>

      {error && (
        <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-8">
          <p><strong>Attention:</strong> {error}</p>
        </div>
      )}

      <section class="mb-16 md:mb-20">
        <h2 class="text-3xl md:text-4xl font-bold font-cal-sans text-slate-950 mb-8">
          Catégories
        </h2>
        
        <div class="flex flex-wrap gap-4 md:gap-6" id="category-filters">
          <div class="category-btn cursor-pointer transition-all duration-300 transform hover:scale-105 opacity-100 ring-2 ring-[#FF6200] ring-offset-2 rounded-2xl md:rounded-3xl bg-white w-[100px] h-[100px] md:w-[130px] md:h-[130px] flex-shrink-0" data-category="all">
            <div class="border border-gray-100 rounded-2xl md:rounded-3xl p-2 flex flex-col items-center justify-center h-full shadow-sm">
              <span class="text-3xl md:text-4xl mb-2">🌍</span>
              <span class="font-bold text-slate-900 text-xs md:text-sm font-cal-sans text-center">Toutes</span>
            </div>
          </div>

          {categories.map((category) => (
            <div class="category-btn cursor-pointer transition-all duration-300 transform hover:scale-105 opacity-60 hover:opacity-100 rounded-2xl md:rounded-3xl bg-white w-[100px] h-[100px] md:w-[130px] md:h-[130px] flex-shrink-0" data-category={category.id}>
              <div class="border border-gray-100 rounded-2xl md:rounded-3xl p-2 flex flex-col items-center justify-center h-full shadow-sm">
                 <img src={category.icon.src} alt={category.nom} class="w-8 h-8 md:w-12 md:h-12 mb-2 object-contain" />
                 <span class="font-bold text-slate-900 text-xs md:text-sm font-cal-sans text-center truncate w-full px-1">{category.nom}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-3xl md:text-4xl font-bold font-cal-sans text-slate-950 mb-8">
          Signes
        </h2>

        {signs.length > 0 ? (
          <>
            <div id="signs-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8">
              {signs.map((sign) => (
                <div class="sign-item w-full h-full" data-sign={sign.id} data-category={signCategories.get(sign.id) || 'quotidien'} data-title={(sign.nom || '').toLowerCase()}>
                  <SignCard
                    title={sign.nom.replace(/_/g, ' ')}
                    image={getImageUrl(sign)}
                    description={sign.description || 'Signe LSF'}
                    videoUrl={getVideoUrl(sign)}
                  />
                </div>
              ))}
            </div>
            
            <div id="no-results" class="hidden text-center text-gray-500 py-16 md:py-24 bg-white rounded-3xl border border-gray-100 mt-8 shadow-sm">
              <span class="text-6xl block mb-4">🔍</span>
              <p class="text-2xl font-bold font-cal-sans text-slate-900">Oups, aucun signe trouvé !</p>
              <p class="text-base font-alexandria mt-2">Essayez de chercher un autre mot ou changez de catégorie.</p>
            </div>
          </>
        ) : (
          <p class="text-center text-gray-500 py-12">Aucun signe disponible</p>
        )}
      </section>
    </main>

    <Footer />
    <VideoModal />
  </div>
</Layout>

<script>
  function setupAllVideoListeners() {
    document.querySelectorAll('.sign-card').forEach(card => {
      const videoUrl = card.getAttribute('data-video-url');
      const signTitle = card.getAttribute('data-sign-title');
      if (!videoUrl || !signTitle) return;
      
      const overlayBtn = card.querySelector('.video-overlay-btn');
      if (overlayBtn) {
        overlayBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const win = window as any;
          if (win.openVideoModal) win.openVideoModal(videoUrl, signTitle);
        });
      }
    });
  }

  function setupSearchAndFilters() {
    const searchInput = document.getElementById('dico-search-input') as HTMLInputElement;
    const categoryBtns = document.querySelectorAll('.category-btn');
    const signItems = document.querySelectorAll('.sign-item');
    const noResults = document.getElementById('no-results');
    
    let currentSearch = '';
    let currentCategory = 'all';

    function filterSigns() {
      let visibleCount = 0;
      signItems.forEach((item) => {
        const element = item as HTMLElement;
        const title = element.getAttribute('data-title') || '';
        const category = element.getAttribute('data-category') || '';
        
        const matchesSearch = title.includes(currentSearch);
        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        
        if (matchesSearch && matchesCategory) {
          element.style.display = 'block';
          visibleCount++;
        } else {
          element.style.display = 'none';
        }
      });
      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterSigns();
      });
    }

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        categoryBtns.forEach(b => {
          b.classList.remove('opacity-100', 'ring-2', 'ring-[#FF6200]', 'ring-offset-2');
          b.classList.add('opacity-60');
        });
        btn.classList.remove('opacity-60');
        btn.classList.add('opacity-100', 'ring-2', 'ring-[#FF6200]', 'ring-offset-2');
        filterSigns();
      });
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupAllVideoListeners();
      setupSearchAndFilters();
    });
  } else {
    setupAllVideoListeners();
    setupSearchAndFilters();
  }
</script>