---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mon Parcours - Wenddy">
  <div class="min-h-screen bg-[#E5E7EB] flex flex-col font-sans overflow-x-hidden">
    
    <!-- En-tête avec la Croix de fermeture -->
    <header class="bg-white py-6 shadow-sm z-20 text-center relative px-4">
      <a href="/" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-black hover:text-[#FF6200] transition-colors" title="Quitter">
        <svg class="w-7 h-7 md:w-9 md:h-9" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </a>

      <h1 class="text-2xl md:text-3xl font-black text-slate-950 font-cal-sans">
        Mon Parcours
      </h1>
      <p class="text-[#FF6200] font-bold mt-1 text-sm md:text-base">Niveau 1 - Débutant</p>
    </header>

    <!-- Zone de la Carte - Centrée type Application Mobile sur PC -->
    <main class="flex-grow flex flex-col items-center justify-center w-full py-8 px-4">
      
      <!-- Conteneur "Style Smartphone" pour garder de super proportions sur PC -->
      <div class="relative w-full max-w-[360px] rounded-3xl shadow-xl overflow-hidden flex justify-center items-center border-4 border-white" style="background-color: #87B44E;">
        
        <!-- JAUGE DE PROGRESSION ORANGE (Fixée à gauche, z-40 tout devant) -->
        <div class="absolute left-4 top-8 bottom-8 w-5 bg-black/25 rounded-full z-40 shadow-inner border border-white/10 overflow-hidden">
          <div id="xp-gauge" class="absolute bottom-0 left-0 w-full bg-[#FF6200] rounded-full transition-all duration-1000 shadow-[0_0_12px_rgba(255,98,0,0.9)]" style="height: 0%;"></div>
        </div>

        <!-- Ton chemin vectorisé qui garde sa taille parfaite -->
        <img src="/src/assets/icones/frame.png" alt="Chemin de progression XP" class="w-full h-auto relative z-10 object-contain block" onerror="this.style.display='none'"/>

      </div>
    </main>

    <!-- Footer -->
    <footer class="w-full py-4 text-center text-gray-400 text-xs bg-white border-t border-gray-200 z-20">
      Projet Wenddy - MMI Montbéliard | ID: o4g3yq8bkgg4bxz
    </footer>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gauge = document.getElementById('xp-gauge');
    
    // Récupère dynamiquement le nombre de mini-jeux réussis mis en mémoire.
    // Par défaut, réglé sur 1 (20%) pour que tu puisses voir la jauge au chargement.
    let jeuxRealises = parseInt(localStorage.getItem('wenddy_games_completed') || '1');
    const totalJeux = 5; 
    
    if (gauge) {
      setTimeout(() => {
        // Sécurité pour ne pas dépasser 100%
        const percentage = Math.min((jeuxRealises / totalJeux) * 100, 100);
        gauge.style.height = `${percentage}%`;
      }, 300);
    }
  });
</script>