---
import lockIcon from '../assets/icones/cadenas.svg?url';
import mascotIcon from '../assets/icones/mascotte.svg?url';
import profileIcon from '../assets/icones/profil.svg?url';
import starIcon from '../assets/icones/etoile.svg?url';
import smallFlameIcon from '../assets/icones/flammes.svg?url';
import settingsIcon from '../assets/icones/paramètre.svg?url';
import bellIcon from '../assets/icones/cloche.svg?url';
import mailIcon from '../assets/icones/mail.svg?url';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <svelte:fragment slot="title">Profil • Wenddy</svelte:fragment>
  <div class="bg-slate-100 min-h-screen text-slate-900 font-sans">
    <main class="max-w-md mx-auto px-4 pb-10 sm:max-w-3xl lg:max-w-4xl sm:px-6">
      <section class="bg-[#FF6200] text-white rounded-b-[40px] pt-8 pb-8 px-5 shadow-orange shadow-sm sm:px-8">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="h-14 w-14 rounded-full bg-white flex-none overflow-hidden aspect-square p-1 sm:h-16 sm:w-16">
              <img src={profileIcon} alt="Avatar" class="w-full h-full object-contain" />
            </div>
            <div>
              <p class="text-sm opacity-80">Profil</p>
              <h1 id="profileName" class="text-xl font-semibold tracking-tight sm:text-2xl">Mama_bgrd</h1>
            </div>
          </div>
          <div class="h-14 w-14 flex items-center justify-center sm:h-16 sm:w-16">
            <img src={mascotIcon} alt="Mascotte" class="h-10 w-10 object-contain sm:h-12 sm:w-12" />
          </div>
        </div>

        <div class="mt-6 flex flex-row flex-wrap gap-4">
          <div class="w-[calc(50%-0.75rem)] rounded-[32px] bg-white/40 p-4 backdrop-blur-sm">
            <p class="flex items-center justify-start gap-2 text-xs tracking-[0.24em] opacity-80">
              <img src={starIcon} alt="Étoile" class="h-6 w-6" />
              XP Total
            </p>
            <p id="xpValue" class="mt-3 text-3xl font-semibold">0</p>
          </div>
          <div class="w-[calc(50%-0.75rem)] rounded-[32px] bg-white/40 p-4 backdrop-blur-sm">
            <p class="flex items-center justify-start gap-2 text-xs tracking-[0.24em] opacity-80">
              <img src={smallFlameIcon} alt="Flammes" class="h-6 w-6" />
              Série actuelle
            </p>
            <p id="seriesValue" class="mt-3 text-3xl font-semibold">0</p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-sm opacity-90">
          <span><strong id="followersValue" class="text-white">0</strong> abonnés</span>
          <span><strong id="followingValue" class="text-white">0</strong> abonnements</span>
        </div>

      </section>

      <div class="mt-6 px-4 sm:px-0">
        <button id="addFriendBtn" class="w-full rounded-full bg-white text-orange-500 font-semibold py-3 shadow-sm">Ajoutez des amis +</button>
      </div>

      <div id="userSearchPanel" class="mt-4 hidden rounded-[32px] bg-white p-4 shadow-sm">
        <div class="flex flex-col gap-3">
          <div class="flex gap-3">
            <input id="userSearchInput" type="search" placeholder="Rechercher un pseudo ou nom" class="min-w-0 flex-1 rounded-3xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-200" />
            <button id="userSearchBtn" class="rounded-full bg-orange-500 px-4 py-3 text-sm font-semibold text-white">Chercher</button>
          </div>
          <p class="text-sm text-slate-500">Clique sur un utilisateur pour l’ajouter.</p>
        </div>
        <div id="userSearchResults" class="mt-4 space-y-3"></div>
      </div>

      <section class="mt-6">
        <h2 class="text-lg font-semibold mb-4">Paramètres</h2>
        <div class="space-y-3">
          <a href="/preference" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={settingsIcon} alt="Paramètres" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Préférences</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
          <a href="/telechargement" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={settingsIcon} alt="Téléchargement" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Téléchargement</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
          <a href="/notifications" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={bellIcon} alt="Notifications" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Notifications</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
          <a href="/contact" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={mailIcon} alt="Contact" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Contact</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
        </div>
      </section>

      <section class="mt-6">
        <h2 class="text-xl font-semibold mb-4">Badges</h2>
        <div id="badgesContainer" class="grid grid-cols-3 gap-3"></div>
      </section>
    </main>

    <script type="module">
      import PocketBase from 'https://cdn.jsdelivr.net/npm/pocketbase@0.27.0/dist/pocketbase.es.js';
      const pb = new PocketBase('http://127.0.0.1:8090');
      const profileNameEl = document.querySelector('#profileName');

      function loadProfileName() {
        const user = pb.authStore.model;
        const name = user?.username || user?.pseudo || user?.name || 'Utilisateur';
        if (profileNameEl) profileNameEl.textContent = name;
      }

      const state = {
        xp: 0,
        series: 0,
        followers: 0,
        following: 0,
        followingUsers: [],
        followerUsers: [],
      };

      const xpValue = document.querySelector('#xpValue');
      const seriesValue = document.querySelector('#seriesValue');
      const followersValue = document.querySelector('#followersValue');
      const followingValue = document.querySelector('#followingValue');
      const addFriendBtn = document.querySelector('#addFriendBtn');
      const searchPanel = document.querySelector('#userSearchPanel');
      const searchInput = document.querySelector('#userSearchInput');
      const searchBtn = document.querySelector('#userSearchBtn');
      const searchResults = document.querySelector('#userSearchResults');
      const badgesContainer = document.querySelector('#badgesContainer');

      async function loadBadges() {
        try {
          const allBadges = await pb.collection('badges').getFullList({ sort: 'nom' });
          const currentUserId = pb.authStore.model?.id;
          let unlockedBadgeIds = new Set();

          if (currentUserId) {
            const userBadges = await pb.collection('user_badges').getFullList({
              filter: `user = "${currentUserId}"`,
            });
            unlockedBadgeIds = new Set(userBadges.map((item) => item.badge).filter(Boolean));
          }

          renderBadges(allBadges, unlockedBadgeIds);
        } catch (error) {
          console.error('Impossible de charger les badges PocketBase', error);
        }
      }

      function renderBadges(badges, unlockedBadgeIds) {
        if (!badgesContainer) return;
        badgesContainer.innerHTML = badges
          .map((badge) => {
            const unlocked = unlockedBadgeIds.has(badge.id);
            const imageUrl = badge.image?.length ? pb.getFileUrl(badge, 'image') : '';
            const iconUrl = unlocked && imageUrl ? imageUrl : lockIcon;
            const badgeName = badge.nom || badge.titre || badge.name || 'Badge';
            const outerClass = unlocked ? 'bg-orange-50' : 'bg-slate-50';
            return `
              <div class="aspect-square rounded-[32px] ${outerClass} p-4 text-center shadow-sm transition">
                <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-3xl bg-slate-100 mx-auto overflow-hidden transition-all">
                  <img src="${iconUrl}" alt="${badgeName}" class="h-8 w-8 object-contain" />
                </div>
                <p class="text-sm font-semibold text-slate-900">${badgeName}</p>
              </div>
            `;
          })
          .join('');
      }

      async function searchUsers(query) {
        const currentId = pb.authStore.model?.id;
        const trimmed = query?.trim();
        if (!trimmed) return [];
        const safeQuery = trimmed.replace(/"/g, '\\"');

        try {
          return await pb.collection('users').getFullList({
            filter: `${currentId ? `id != \"${currentId}\" && ` : ''}` +
              `(username~\"${safeQuery}\" || pseudo~\"${safeQuery}\" || name~\"${safeQuery}\")`,
            sort: 'username',
          });
        } catch (error) {
          console.error('Recherche utilisateur impossible', error);
          return [];
        }
      }

      function formatUserLabel(user) {
        return user?.username || user?.pseudo || user?.name || 'Utilisateur';
      }

      function renderSearchResults(users) {
        if (!searchResults) return;
        if (!users.length) {
          searchResults.innerHTML = '<div class="rounded-3xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">Aucun utilisateur trouvé.</div>';
          return;
        }

        searchResults.innerHTML = users
          .map((user) => {
            const isFollowing = state.followingUsers.includes(user.id);
            return `
              <div class="flex items-center justify-between gap-3 rounded-3xl border border-slate-200 p-4">
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900">${formatUserLabel(user)}</p>
                  <p class="text-sm text-slate-500">${user.email || 'Utilisateur PocketBase'}</p>
                </div>
                <button data-user-id="${user.id}" class="follow-btn rounded-full px-4 py-2 text-sm font-semibold ${isFollowing ? 'bg-slate-200 text-slate-600' : 'bg-orange-500 text-white'}" ${isFollowing ? 'disabled' : ''}>
                  ${isFollowing ? 'Déjà suivi' : 'Ajouter'}
                </button>
              </div>
            `;
          })
          .join('');

        searchResults.querySelectorAll('.follow-btn').forEach((button) => {
          button.addEventListener('click', (event) => {
            const userId = event.currentTarget.dataset.userId;
            const user = users.find((u) => u.id === userId);
            if (user) addFollowing(user, event.currentTarget);
          });
        });
      }

      function addFollowing(user, button) {
        if (state.followingUsers.includes(user.id)) return;
        state.followingUsers.push(user.id);
        state.following = state.followingUsers.length;
        render();

        if (button) {
          button.textContent = 'Déjà suivi';
          button.classList.remove('bg-orange-500', 'text-white');
          button.classList.add('bg-slate-200', 'text-slate-600');
          button.setAttribute('disabled', '');
        }

        const willFollowBack = Math.random() < 0.5;
        if (willFollowBack) {
          setTimeout(() => {
            if (!state.followerUsers.includes(user.id)) {
              state.followerUsers.push(user.id);
              state.followers = state.followerUsers.length;
              render();
            }
          }, 2200);
        }
      }

      function doSearch() {
        const query = searchInput?.value || '';
        searchUsers(query).then(renderSearchResults);
      }

      function toggleSearchPanel() {
        if (!searchPanel) return;
        searchPanel.classList.toggle('hidden');
        if (!searchPanel.classList.contains('hidden')) {
          searchInput?.focus();
        }
      }

      function render() {
        xpValue.textContent = state.xp;
        seriesValue.textContent = state.series;
        followersValue.textContent = state.followers;
        followingValue.textContent = state.following;
      }

      addFriendBtn.addEventListener('click', toggleSearchPanel);
      searchBtn.addEventListener('click', doSearch);
      searchInput?.addEventListener('keypress', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          doSearch();
        }
      });

      loadProfileName();
      loadBadges();
      pb.authStore.onChange(() => {
        loadProfileName();
        loadBadges();
      });

      render();
    </script>
  </div>
</Layout>
