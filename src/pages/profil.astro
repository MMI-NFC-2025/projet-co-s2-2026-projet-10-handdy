---
import lockIcon from '../assets/icones/cadenas.svg?url';
import mascotIcon from '../assets/icones/mascotte.svg?url';
import profileIcon from '../assets/icones/profil.svg?url';
import starIcon from '../assets/icones/etoile.svg?url';
import smallFlameIcon from '../assets/icones/flammes.svg?url';
import settingsIcon from '../assets/icones/paramètre.svg?url';
import bellIcon from '../assets/icones/cloche.svg?url';
import mailIcon from '../assets/icones/mail.svg?url';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

import { searchUsers, followUser, unfollowUser, isAuthenticated, isFollowing, getFollowCounts } from '../../backend/backend.mjs';
---

<Layout>
  <svelte:fragment slot="title">Profil • Wenddy</svelte:fragment>
 
  <div class="bg-slate-100 min-h-screen text-slate-900 font-sans">
    <main class="max-w-md mx-auto px-4 pb-10 sm:max-w-3xl lg:max-w-4xl sm:px-6">
      
      <section class="bg-[#FF6200] text-white rounded-b-[40px] pt-8 pb-8 px-5 shadow-orange shadow-sm sm:px-8">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="h-14 w-14 rounded-full bg-white flex-none overflow-hidden aspect-square p-1 sm:h-16 sm:w-16">
              <img src={profileIcon} alt="Avatar" class="w-full h-full object-contain" />
            </div>
            <div>
              <p class="text-sm opacity-80">Profil</p>
              <h1 id="profileName" class="text-xl font-semibold tracking-tight sm:text-2xl"></h1>
            </div>
          </div>
          <div class="h-14 w-14 flex items-center justify-center sm:h-16 sm:w-16">
            <img src={mascotIcon} alt="Mascotte" class="h-10 w-10 object-contain sm:h-12 sm:w-12" />
          </div>
        </div>

        <div class="mt-6 flex flex-row flex-wrap gap-4">
          <div class="w-[calc(50%-0.75rem)] rounded-[32px] bg-white/40 p-4 backdrop-blur-sm">
            <p class="flex items-center justify-start gap-2 text-xs tracking-[0.24em] opacity-80">
              <img src={starIcon} alt="Étoile" class="h-6 w-6" />
              XP Total
            </p>
            <p id="xpValue" class="mt-3 text-3xl font-semibold">0</p>
          </div>
          <div class="w-[calc(50%-0.75rem)] rounded-[32px] bg-white/40 p-4 backdrop-blur-sm">
            <p class="flex items-center justify-start gap-2 text-xs tracking-[0.24em] opacity-80">
              <img src={smallFlameIcon} alt="Flammes" class="h-6 w-6" />
              Série actuelle
            </p>
            <p id="seriesValue" class="mt-3 text-3xl font-semibold">0</p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-sm opacity-90">
          <span><strong id="followersValue" class="text-white">0</strong> abonnés</span>
          <span><strong id="followingValue" class="text-white">0</strong> abonnements</span>
        </div>
      </section>

      <div class="mt-6 px-4 sm:px-0">
        <button id="addFriendBtn" class="w-full rounded-full bg-white text-orange-500 font-semibold py-3 shadow-sm">Ajoutez des amis +</button>
      </div>

      <div id="userSearchPanel" class="mt-4 hidden rounded-[32px] bg-white p-4 shadow-sm">
        <div class="flex flex-col gap-3">
          <div class="flex gap-3">
            <input id="userSearchInput" type="search" placeholder="Rechercher un pseudo ou nom" class="min-w-0 flex-1 rounded-3xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-200" />
            <button id="userSearchBtn" class="rounded-full bg-orange-500 px-4 py-3 text-sm font-semibold text-white">Chercher</button>
          </div>
          <p class="text-sm text-slate-500">Clique sur un utilisateur pour l’ajouter.</p>
        </div>
        <div id="userSearchResults" class="mt-4 space-y-3"></div>
      </div>

      <section class="mt-6">
        <h2 class="text-lg font-semibold mb-4">Paramètres</h2>
        <div class="space-y-3">
          <a href="/telechargement" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={settingsIcon} alt="Paramètres" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Téléchargement</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
          <a href="/notifications" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={bellIcon} alt="Notifications" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Notifications</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
          <a href="/contact" class="group flex items-center justify-between rounded-[32px] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 w-full">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100">
                <img src={mailIcon} alt="Contact" class="h-5 w-5 object-contain" />
              </span>
              <div>
                <p class="font-semibold">Contact</p>
              </div>
            </div>
            <span class="text-slate-400">›</span>
          </a>
        </div>
      </section>

      <section class="mt-6">
        <h2 class="text-xl font-semibold mb-4">Badges</h2>
        <div id="badgeGrid" class="grid grid-cols-1 gap-4 sm:grid-cols-3"></div>
      </section>

      <div class="mt-8 px-4 sm:px-0">
        <Button id="logoutBtn" type="button" class="w-full bg-red-600 text-red-50 hover:bg-red-100 shadow-none">
          Se déconnecter
        </Button>
      </div>

      <button id="test-btn" class="bg-orange-500 text-blue-400 p-4 rounded-full">
  Test Notif Immédiat
</button>
    </main>
  </div>

  <script>

  import { 
    isAuthenticated, 
    logout, 
    getUserProfileStats, 
    searchUsers, 
    followUser, 
    unfollowUser, 
    isFollowing, 
    getFollowCounts,
  } from '../../backend/backend.mjs';

  function getPersistedAuth() { 
    try { 
      const raw = localStorage.getItem('pb_auth'); 
      return raw ? JSON.parse(raw) : null; 
    } catch { 
      return null; 
    } 
  }


  function getCurrentUser() { 
    const auth = getPersistedAuth(); 
    return auth?.record || auth?.model || null; 
  }

  // Éléments du DOM (Profil & Stats)
  const profileNameEl = document.querySelector('#profileName');
  const xpValueEl = document.querySelector('#xpValue');
  const seriesValueEl = document.querySelector('#seriesValue');
  const badgeGrid = document.querySelector('#badgeGrid');
  const followersValueEl = document.querySelector('#followersValue');
  const followingValueEl = document.querySelector('#followingValue');
  const logoutBtn = document.querySelector('#logoutBtn');

  // Éléments du DOM (Recherche d'amis)
  const addFriendBtn = document.querySelector('#addFriendBtn');
  const userSearchPanel = document.querySelector('#userSearchPanel');
  const userSearchBtn = document.querySelector('#userSearchBtn');
  const userSearchResults = document.querySelector('#userSearchResults');
  const userSearchInput = document.querySelector('#userSearchInput') as HTMLInputElement;

  const currentUser = getCurrentUser(); 
  if (currentUser && profileNameEl) { 
    profileNameEl.textContent = currentUser.pseudo || currentUser.username || currentUser.email || 'Utilisateur'; 
  }

  const badgeDefinitions = [
    { id: 'serie', title: 'Série 14 jours', description: 'Atteins 14 jours consécutifs de pratique pour débloquer ce badge.', unlockedIcon: '🏆', lockedIcon: '🔒' },
    { id: 'lecon', title: '50 leçons', description: 'Complète 50 sessions pour débloquer ce badge.', unlockedIcon: '🎓', lockedIcon: '🔒' },
    { id: 'novice', title: 'Novice', description: 'Obtiens les deux premiers badges pour le débloquer.', unlockedIcon: '✨', lockedIcon: '🔒' },
  ];

  function renderBadges({ seriesCount, lessonCount, serieUnlocked, lessonUnlocked, noviceUnlocked }: any) {
    if (!badgeGrid) return;

    badgeGrid.innerHTML = badgeDefinitions
      .map((badge) => {
        const unlocked = badge.id === 'serie' ? serieUnlocked : badge.id === 'lecon' ? lessonUnlocked : noviceUnlocked;
        const progress = badge.id === 'serie' ? `${seriesCount}/14 jours` : badge.id === 'lecon' ? `${lessonCount}/50 leçons` : `${serieUnlocked && lessonUnlocked ? 'Débloqué' : 'Bloqué'}`;

        return `
          <div class="rounded-[32px] border p-4 text-center shadow-sm transition ${unlocked ? 'border-orange-200 bg-orange-50' : 'border-slate-200 bg-white'}">
            <div class="mb-3 mx-auto flex h-14 w-14 items-center justify-center rounded-3xl text-3xl ${unlocked ? 'bg-orange-100' : 'bg-slate-100 grayscale opacity-70'}">
              ${unlocked ? badge.unlockedIcon : badge.lockedIcon}
            </div>
            <p class="text-sm font-semibold ${unlocked ? 'text-slate-900' : 'text-slate-400'}">${badge.title}</p>
            <p class="mt-2 text-xs ${unlocked ? 'text-slate-600' : 'text-slate-500'}">${badge.description}</p>
            <p class="mt-3 text-[0.75rem] ${unlocked ? 'text-orange-600' : 'text-slate-400'}">${progress}</p>
          </div>
        `;
      })
      .join('');
  }

  async function loadProfileData() {
    if (!isAuthenticated()) {
      if (xpValueEl) xpValueEl.textContent = '—';
      if (seriesValueEl) seriesValueEl.textContent = '—';
      if (badgeGrid) {
        badgeGrid.innerHTML = '<div class="rounded-[32px] border border-slate-200 bg-white p-4 text-sm text-slate-500">Connecte-toi pour voir tes badges et tes stats.</div>';
      }
      return;
    }

    const user = getCurrentUser();
    if (user) {
      try {
        const stats = await getUserProfileStats(user.id);
        if (xpValueEl) xpValueEl.textContent = String(stats.xpTotal);
        if (seriesValueEl) seriesValueEl.textContent = String(stats.seriesCount);
        renderBadges(stats);
        
        const counts = await getFollowCounts(user.id);
        if (followersValueEl) followersValueEl.textContent = String(counts.followers);
        if (followingValueEl) followingValueEl.textContent = String(counts.following);
      } catch (error) {
        console.error("Erreur lors du chargement des statistiques", error);
      }
    }
  }

  // --- Toggle d'affichage du panneau ---
  if (addFriendBtn && userSearchPanel) {
    addFriendBtn.addEventListener('click', () => {
      userSearchPanel.classList.toggle('hidden');
    });
  }

  // --- Logique de recherche ---
  if (userSearchInput && userSearchResults) {
    const doSearch = async () => {
      const query = userSearchInput.value.trim();
      
      if (!query) {
        userSearchResults.innerHTML = '';
        return;
      }

      userSearchResults.innerHTML = '<p class="text-sm text-slate-500">Recherche en cours...</p>';

      try {
        const results = await searchUsers(query);
        
        if (results.items.length === 0) {
          userSearchResults.innerHTML = '<p class="text-sm text-slate-500">Aucun utilisateur trouvé.</p>';
          return;
        }

        userSearchResults.innerHTML = ''; 
        
        for (const targetUser of results.items) {
          const alreadyFollowing = await isFollowing(targetUser.id);
          
          const userDiv = document.createElement('div');
          userDiv.className = 'flex items-center justify-between p-3 border border-slate-100 rounded-2xl bg-slate-50';
          
          const nameSpan = document.createElement('span');
          nameSpan.className = 'font-semibold text-sm text-slate-800';
          nameSpan.textContent = targetUser.pseudo || targetUser.username || 'Utilisateur';

          const actionBtn = document.createElement('button');
          actionBtn.className = `text-xs px-4 py-2 rounded-full font-semibold transition ${alreadyFollowing ? 'bg-slate-200 text-slate-700 hover:bg-slate-300' : 'bg-orange-100 text-orange-600 hover:bg-orange-200'}`;
          actionBtn.textContent = alreadyFollowing ? 'Ne plus suivre' : 'Suivre';
          
          actionBtn.addEventListener('click', async () => {
            const isNowFollowing = actionBtn.textContent === 'Ne plus suivre';
            actionBtn.disabled = true;
            actionBtn.classList.add('opacity-50');
            
            try {
        
              let currentFollowingCount = 0;
              if (followingValueEl) {
                currentFollowingCount = parseInt(followingValueEl.textContent || '0', 10);
              }

              if (isNowFollowing) {
          
                await unfollowUser(targetUser.id);
                actionBtn.textContent = 'Suivre';
                actionBtn.className = 'text-xs px-4 py-2 rounded-full font-semibold transition bg-orange-100 text-orange-600 hover:bg-orange-200';
                
               
                if (followingValueEl) followingValueEl.textContent = String(Math.max(0, currentFollowingCount - 1));

              } else {
               
                await followUser(targetUser.id);
                actionBtn.textContent = 'Ne plus suivre';
                actionBtn.className = 'text-xs px-4 py-2 rounded-full font-semibold transition bg-slate-200 text-slate-700 hover:bg-slate-300';
                
                
                if (followingValueEl) followingValueEl.textContent = String(currentFollowingCount + 1);
              }
              
            } catch(err) {
              console.error(err);
            } finally {
              actionBtn.disabled = false;
              actionBtn.classList.remove('opacity-50');
            }
          });

          userDiv.appendChild(nameSpan);
          userDiv.appendChild(actionBtn);
          userSearchResults.appendChild(userDiv);
        }
      } catch (error) {
        console.error(error);
        userSearchResults.innerHTML = '<p class="text-sm text-red-500">Erreur lors de la recherche.</p>';
      }
    };

    
    if (userSearchBtn) {
      userSearchBtn.addEventListener('click', doSearch);
    }

   
    userSearchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault(); 
        doSearch();
      }
    });

   
    userSearchInput.addEventListener('search', () => {
      if (userSearchInput.value === '') {
        userSearchResults.innerHTML = ''; 
      }
    });
  }

  // --- LOGIQUE DE DÉCONNEXION ---
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      logout();
      localStorage.removeItem('pocketbase_auth'); 
      localStorage.removeItem('pb_auth');
      window.location.href = '/login'; 
    });
  }

  loadProfileData();
  

  import { triggerNotification } from '../../backend/notifications.js';

  // On attend que le DOM soit chargé
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('test-btn');
    
    // On ajoute l'écouteur d'événement directement sur le bouton
    btn?.addEventListener('click', () => {
      console.log("Tentative d'envoi...");
      triggerNotification("Test Wenddy", "Si tu lis ceci, les notifications fonctionnent !");
    });
  });
  </script>
</Layout>