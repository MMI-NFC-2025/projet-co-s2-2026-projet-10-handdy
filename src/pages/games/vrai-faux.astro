---
import Layout from '../../layouts/Layout.astro';
import { gamesVraiFauxAll, getFileUrl, addScore, getCurrentUser, gameTypesAll } from '../../../backend/backend.mjs';
let questions: any[] = [];

try {
  const rawData = await gamesVraiFauxAll();
  
  questions = rawData.map((q: any) => {
    const signeLie = q.expand?.relation;
    const videoUrl = signeLie 
      ? getFileUrl(signeLie, signeLie.video) 
      : null;

    return {
      id: q.id,
      video: videoUrl,
      word: q.select || 'Mot',
      correct_answer: q.bool === true,
      question_text: q.questions || 'Le signe présenté correspond-il au mot proposé ?'
    };
  });

} catch (e) {
  console.error("Erreur chargement questions:", e);
}

const allGameTypes = await gameTypesAll();
const vraiFauxType = allGameTypes.find((g: any) => g.nom.toLowerCase().includes('vrai'));
const gameTypeId = vraiFauxType?.id || '';
---

<Layout title="Mode Vrai ou Faux - Wenddy" showHeader={false} showFooter={false}>
  <div class="min-h-screen bg-[#E5E7EB] flex flex-col font-sans overflow-x-hidden">
    
    <main class="flex-grow flex flex-col justify-between pb-12">
      
      <div class="bg-white rounded-b-3xl py-6 px-4 shadow-sm relative z-10 mb-8 md:mb-12">
        <div class="max-w-5xl mx-auto relative flex flex-col items-center">
          <a href="/arcade" class="absolute left-0 top-0 text-black hover:text-[#FF6200] transition-colors" title="Quitter le jeu">
            <svg class="w-7 h-7 md:w-9 md:h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </a>
          
          <p id="compteur-question" class="text-sm md:text-lg font-bold mb-3 text-gray-700 font-cal-sans">Question 1/5</p>
          
          <div class="w-full max-w-md md:max-w-xl h-4 md:h-5 bg-gray-200 rounded-full relative">
            <div id="barre-progression" class="h-full bg-[#FF6200] rounded-full transition-all duration-300" style="width: 20%;">
              <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-10 h-10 md:w-14 md:h-14 flex items-center justify-center">
                <img src="/src/assets/icones/mascotte.svg" alt="Mascotte Wenddy" class="w-full h-full drop-shadow-md object-contain" onerror="this.style.display='none'"/>
              </div>
            </div>
          </div>
        </div>
      </div>

      <section class="flex-grow flex flex-col items-center justify-center px-4 max-w-sm mx-auto w-full py-2">
        
        <h1 class="text-xl md:text-4xl font-black text-slate-950 mb-6 text-center font-cal-sans leading-tight">
          Ce signe correspond-il <br /> au mot proposé ?
        </h1>

        <div id="media-card" class="w-full max-w-[280px] aspect-[4/5] bg-gray-200 rounded-3xl border-4 border-transparent shadow-sm relative overflow-hidden flex items-center justify-center mb-5 cursor-pointer">
          <div id="video-container" class="w-full h-full pointer-events-none"></div>
        </div>

        <div id="word-box" class="w-full max-w-[280px] bg-white rounded-2xl py-4 px-6 shadow-sm text-center mb-6">
          <span id="proposed-word" class="text-2xl font-bold text-slate-900 font-cal-sans">Chargement...</span>
        </div>

        <div class="flex w-full max-w-[280px] gap-4">
          <button id="btn-vrai" class="flex-1 bg-slate-900 text-white font-bold text-xl py-4 rounded-2xl shadow-md transition-all font-cal-sans outline-none">
            Vrai
          </button>
          <button id="btn-faux" class="flex-1 bg-slate-900 text-white font-bold text-xl py-4 rounded-2xl shadow-md transition-all font-cal-sans outline-none">
            Faux
          </button>
        </div>

      </section>

    </main>

  </div>
</Layout>

<style is:global>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-8px); }
    80% { transform: translateX(8px); }
  }
  .animate-shake { 
    animation: shake 0.4s ease-in-out; 
  }
</style>

<script define:vars={{ questions, gameTypeId }}>
  window.__vraiFauxQuestions = questions;
  window.__vraiFauxGameTypeId = gameTypeId;
</script>

<script>
  import { pb, addScore, enregistrerProgression } from '../../../backend/backend.mjs';

  type VraiFauxRaw = {
    id: string;
    video: string | null;
    word: string;
    correct_answer: boolean;
  };

  type VraiFauxQuestion = {
    id: string;
    videoUrl: string | null;
    proposedWord: string;
    isTrue: boolean;
  };

  declare global {
    interface Window {
      __vraiFauxQuestions: VraiFauxRaw[];
      __vraiFauxGameTypeId: string;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const gameData: VraiFauxQuestion[] = (window.__vraiFauxQuestions || []).map((q: VraiFauxRaw) => ({
      id: q.id,
      videoUrl: q.video,
      proposedWord: q.word,
      isTrue: q.correct_answer,
    }));
    const gameTypeId: string = window.__vraiFauxGameTypeId || '';

    let currentIndex = 0;
    let sessionXP = 0;
    const totalQuestions = gameData.length;
    let canClick = true;

    const proposedWordText = document.getElementById('proposed-word');
    const videoContainer = document.getElementById('video-container');
    const btnVrai = document.getElementById('btn-vrai');
    const btnFaux = document.getElementById('btn-faux');
    const compteur = document.getElementById('compteur-question');
    const barre = document.getElementById('barre-progression');

    function loadQuestion() {
      canClick = true;
      const currentData = gameData[currentIndex];

      if (proposedWordText) proposedWordText.innerText = currentData.proposedWord;

      const progressPercent = Math.max(5, (currentIndex / totalQuestions) * 100);
      if (compteur) compteur.innerText = `Question ${currentIndex + 1}/${totalQuestions}`;
      if (barre) barre.style.width = `${progressPercent}%`;

      if (videoContainer) {
        if (currentData.videoUrl) {
          videoContainer.innerHTML = `
            <video 
              src="${currentData.videoUrl}" 
              class="w-full h-full object-cover" 
              muted loop playsinline autoplay
            ></video>`;
        } else {
          videoContainer.innerHTML = '';
        }
      }
    }

    async function finDePartie() {
      const user = pb.authStore.model;

      if (user && sessionXP > 0) {
        try {
          await pb.collection('user_games').create({
            user: user.id,
            xp_gagne: sessionXP,
            date_session: new Date().toISOString(),
          });

          await enregistrerProgression(user.id, sessionXP);

          await addScore({
            user: user.id,
            game_type: gameTypeId,
            points: sessionXP,
            duration: 0,
          });
        } catch (e) {
          console.error('Erreur sauvegarde score:', e);
        }
      }

      window.location.href = '/progres';
    }

    function handleAnswer(userAnswer: boolean, clickedBtnId: string) {
      if (!canClick) return;
      canClick = false;

      const currentData = gameData[currentIndex];
      const isCorrect = userAnswer === currentData.isTrue;
      const clickedBtn = document.getElementById(clickedBtnId);

      if (isCorrect) {
        sessionXP += 10;
        const vid = videoContainer?.querySelector('video');
        if (vid) vid.play();

        if (clickedBtn) {
          clickedBtn.classList.replace('bg-slate-900', 'bg-green-500');
          clickedBtn.classList.add('ring-4', 'ring-green-200');
        }

        const progressPercent = ((currentIndex + 1) / totalQuestions) * 100;
        if (barre) barre.style.width = `${progressPercent}%`;

        setTimeout(async () => {
          if (clickedBtn) {
            clickedBtn.classList.replace('bg-green-500', 'bg-slate-900');
            clickedBtn.classList.remove('ring-4', 'ring-green-200');
          }
          if (currentIndex < totalQuestions - 1) {
            currentIndex++;
            loadQuestion();
          } else {
            await finDePartie();
          }
        }, 1500);

      } else {
        if (clickedBtn) {
          clickedBtn.classList.replace('bg-slate-900', 'bg-red-500');
          clickedBtn.classList.add('animate-shake', 'ring-4', 'ring-red-200');

          setTimeout(() => {
            clickedBtn.classList.remove('animate-shake', 'ring-4', 'ring-red-200');
            clickedBtn.classList.replace('bg-red-500', 'bg-slate-900');
            canClick = true;
          }, 600);
        }
      }
    }

    if (btnVrai) btnVrai.addEventListener('click', () => handleAnswer(true, 'btn-vrai'));
    if (btnFaux) btnFaux.addEventListener('click', () => handleAnswer(false, 'btn-faux'));

    loadQuestion();
  });
</script>