---
import Layout from '../layouts/Layout.astro';
import starIcon from '../assets/icones/etoile.svg?url';
import flameIcon from '../assets/icones/flammes.svg?url';
import ProgressSection from '../components/ProgressSection.astro';
import { getUserProfileStats, scoresAll, isAuthenticated, pb } from '../../backend/backend.mjs';
import lockIcon from '../assets/icones/cadenas.svg?url';
---

<Layout title="Progression • Wenddy">
  <div class="bg-slate-100 min-h-screen text-slate-900 font-sans pb-10">
    
    <section class="bg-[#FF6200] text-white rounded-b-[40px] pt-10 pb-10 px-6 shadow-lg mb-10">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <div>
          <h1 class="text-3xl md:text-5xl font-bold">Tes Progrès</h1>
          <p class="text-lg opacity-90 mt-2">Suis ton évolution jour après jour</p>
        </div>
      </div>
    </section>

    <main class="max-w-md mx-auto px-4 sm:max-w-3xl lg:max-w-4xl sm:px-6">
      
      <div class="flex gap-4 mb-6">
        <div class="flex-1 rounded-[32px] bg-white p-6 shadow-sm">
          <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500">
            <img src={starIcon} alt="XP" class="h-6 w-6" /> XP Total
          </p>
          <p id="xpValue" class="mt-3 text-3xl font-bold">0</p>
        </div>
        <div class="flex-1 rounded-[32px] bg-white p-6 shadow-sm">
          <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500">
            <img src={flameIcon} alt="Série" class="h-6 w-6" /> Série
          </p>
          <p id="seriesValue" class="mt-3 text-3xl font-bold">0</p>
        </div>
      </div>

      <div class="bg-white p-6 rounded-[32px] shadow-sm mb-6">
        <h2 class="text-lg font-semibold mb-6">XP de la semaine</h2>
        <div id="weeklyGraph" class="flex justify-between items-end h-32 gap-2"></div>
      </div>

      <section class="mb-6">
        <h2 class="text-lg font-semibold mb-4">Badges</h2>
        <div id="badgeGrid" data-lock-icon={lockIcon} class="grid grid-cols-1 gap-4 sm:grid-cols-3"></div>
      </section>

      <div class="bg-white p-6 rounded-[32px] shadow-sm mb-6">
        <h2 class="text-lg font-semibold mb-1">Temps d'apprentissage</h2>
        <p id="timeValue" class="text-3xl font-bold text-orange-600">0h 00min</p>
      </div>

     <section>
  <ProgressSection
    image="/images/chemin_utilisateur_accueil.webp"
    buttonText="Voir l'avancée"
    buttonLink="/chemin"
  />
</section>

    </main>
  </div>

  <script>
    import { getUserProfileStats, scoresAll, isAuthenticated, pb } from '../../backend/backend.mjs';

    const xpValueEl = document.querySelector('#xpValue');
    const seriesValueEl = document.querySelector('#seriesValue');
    const badgeGrid = document.querySelector('#badgeGrid') as HTMLElement;
    const weeklyGraph = document.querySelector('#weeklyGraph');
    const timeValueEl = document.querySelector('#timeValue');

    const badgeDefinitions = [
      { id: 'serie', title: 'Série 14 jours', description: '14 jours consécutifs.', unlockedIcon: '🏆' },
      { id: 'lecon', title: '50 leçons', description: 'Complète 50 sessions.', unlockedIcon: '🎓' },
      { id: 'novice', title: 'Novice', description: 'Débutant assidu.', unlockedIcon: '✨' },
    ];

    async function loadProgressData() {
      if (!isAuthenticated()) return;
      const user = pb.authStore.model;
      if (!user) return;

      try {
        const stats = await getUserProfileStats(user.id);
        const allScores = await scoresAll();
        
        if (xpValueEl) xpValueEl.textContent = String(stats.xpTotal);
        if (seriesValueEl) seriesValueEl.textContent = String(stats.seriesCount);
        
        const totalMinutes = stats.lessonCount * 10;
        const hours = Math.floor(totalMinutes / 60);
        const mins = totalMinutes % 60;
        if (timeValueEl) timeValueEl.textContent = `${hours}h ${mins}min`;

        renderBadges(stats);
        renderGraph(allScores.filter(s => s.user === user.id));
      } catch (err) {
        console.error("Erreur chargement progrès:", err);
      }
    }

    function renderBadges({ serieUnlocked, lessonUnlocked, noviceUnlocked }: any) {
      if (!badgeGrid) return;
      const lockIconUrl = badgeGrid.dataset.lockIcon;
      const lockedHtml = `<img src="${lockIconUrl}" class="w-8 h-8 object-contain" alt="Verrouillé" />`;

      badgeGrid.innerHTML = badgeDefinitions.map(badge => {
        const unlocked = badge.id === 'serie' ? serieUnlocked : badge.id === 'lecon' ? lessonUnlocked : noviceUnlocked;
        return `
          <div class="rounded-[32px] border p-4 text-center ${unlocked ? 'bg-orange-50 border-orange-200' : 'bg-white border-slate-200'}">
            <div class="flex items-center justify-center h-12 mb-2">
                ${unlocked ? `<span class="text-3xl">${badge.unlockedIcon}</span>` : lockedHtml}
            </div>
            <p class="text-sm font-semibold">${badge.title}</p>
          </div>
        `;
      }).join('');
    }

    function renderGraph(userScores: any[]) {
      if (!weeklyGraph) return;
      const days = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
      const weekXP = [0,0,0,0,0,0,0];
      userScores.forEach(s => {
        const day = new Date(s.created).getDay();
        const index = day === 0 ? 6 : day - 1;
        weekXP[index] += Number(s.xp_earned) || 0;
      });

      weeklyGraph.innerHTML = days.map((day, i) => `
        <div class="flex flex-col items-center">
          <div class="w-8 bg-orange-100 rounded-t-lg relative" style="height: 100px">
            <div class="absolute bottom-0 w-full bg-orange-500 rounded-t-lg" style="height: ${Math.min(weekXP[i], 100)}px"></div>
          </div>
          <p class="text-xs mt-2 text-slate-500">${day}</p>
        </div>
      `).join('');
    }


    loadProgressData();
  </script>
</Layout>