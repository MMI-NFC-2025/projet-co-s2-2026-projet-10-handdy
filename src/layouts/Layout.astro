---
import '../style/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Wenddy — Apprends la langue des signes française avec des mini-jeux et défis." />
    <title>Wenddy – Maîtrise la LSF</title>
  </head>
  <body class="bg-gray-100 min-h-screen text-slate-900">
  <body>
    <Header />
    <slot />

    <script>
      import { initNotifications, planifierRappelQuotidien,} from '../../backend/notifications.js';
    
          window.addEventListener('load', () => {
            initNotifications();
            planifierRappelQuotidien(14, 0); 
  });
    
      window.addEventListener('load', () => {
        initNotifications();
      });
      window.addEventListener('load', initNotifications);
    </script>
    <Footer />
  </body>
</html>