---
/**
 * VraiFauxGame Component
 * Jeu Vrai ou Faux - composant principal
 */

import QuestionProgress from './QuestionProgress.astro';
import AnswerButton from './AnswerButton.astro';

interface Question {
  id: string;
  video_or_image?: string;
  word?: string;
  correct_answer: boolean;
  description?: string;
}

interface Props {
  questions: Question[];
}

const { questions } = Astro.props;
---

<div class="min-h-screen bg-slate-50 flex flex-col">
  <!-- Close Button -->
  <div class="flex justify-end p-4 md:p-6">
    <a 
      href="/" 
      class="text-slate-600 hover:text-slate-900 transition-colors"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </a>
  </div>

  <!-- Game Container -->
  <div class="flex-1 flex items-center justify-center p-4 md:p-6">
    <div class="w-full max-w-md bg-white rounded-2xl p-6 md:p-8 shadow-md">
      <!-- Progress -->
      <QuestionProgress current={1} total={questions.length} />

      <!-- Question -->
      <div class="mb-6">
        <p class="text-center text-slate-900 font-semibold text-lg md:text-xl">
          Le signe présenté dans la vidéo correspond-il au mot proposé ?
        </p>
      </div>

      <!-- Video/Image Container -->
      <div class="mb-8 flex justify-center">
        <div class="w-32 h-32 md:w-40 md:h-40 bg-slate-100 rounded-2xl flex items-center justify-center overflow-hidden">
          {questions.length > 0 && questions[0].video_or_image && (
            <img 
              src={questions[0].video_or_image} 
              alt={questions[0].word || 'Question signe'}
              class="w-full h-full object-cover"
            />
          )}
        </div>
      </div>

      <!-- Word Label -->
      {questions.length > 0 && questions[0].word && (
        <div class="text-center mb-8">
          <p class="text-slate-600 text-sm">Mot proposé</p>
          <p class="text-slate-900 font-bold text-lg">{questions[0].word}</p>
        </div>
      )}

      <!-- Buttons -->
      <div class="space-y-3">
        <AnswerButton 
          label="Travailler"
          type="neutral"
        />
        <div class="grid grid-cols-2 gap-3">
          <AnswerButton 
            label="Vrai"
            type="vrai"
          />
          <AnswerButton 
            label="Faux"
            type="faux"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-6 md:py-8">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="flex flex-col items-center space-y-4">
        <!-- Logo -->
        <svg class="w-12 h-12" viewBox="0 0 40 40" fill="none">
          <text x="20" y="28" font-size="24" font-weight="bold" text-anchor="middle">W</text>
        </svg>

        <!-- Social Links -->
        <div class="flex gap-4">
          <a href="#" class="text-slate-600 hover:text-slate-900">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5c-.563-.074-2.313-.229-4.425-.229-4.404 0-7.42 2.703-7.42 7.622v1.707z"/>
            </svg>
          </a>
          <a href="#" class="text-slate-600 hover:text-slate-900">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.07 1.645.07 4.849 0 3.205-.012 3.584-.07 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.849.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.015-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
              <circle cx="12" cy="12" r="3.305"/>
              <circle cx="18.613" cy="5.388" r=".774"/>
            </svg>
          </a>
          <a href="#" class="text-slate-600 hover:text-slate-900">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.633 7.997c.013.175.013.349.013.523 0 5.325-4.053 11.461-11.46 11.461-2.282 0-4.402-.661-6.194-1.888.324.037.636.05.973.05 1.883 0 3.616-.645 5.038-1.727-1.785-.033-3.281-1.224-3.796-2.851.281.038.572.05.865.05.36 0 .72-.05 1.056-.143-1.872-.378-3.276-2.04-3.276-4.04v-.051c.537.304 1.157.496 1.818.52-.1-.066-.204-.132-.303-.199-1.1-1.023-1.853-2.798-1.853-4.592 0-1.017.273-1.966.75-2.772 2.015 2.479 5.038 4.105 8.455 4.276-.065-.299-.1-.611-.1-.923 0-2.237 1.817-4.054 4.055-4.054 1.167 0 2.221.492 2.96 1.278.923-.179 1.797-.512 2.58-1.01-.302.938-.943 1.727-1.776 2.228.819-.099 1.601-.315 2.327-.637-.541.817-1.223 1.533-2.003 2.11z"/>
            </svg>
          </a>
          <a href="#" class="text-slate-600 hover:text-slate-900">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23 0H1C.4 0 0 .4 0 1v22c0 .6.4 1 1 1h11.3v-9.3H9.5v-3.6h2.8V9c0-2.8 1.7-4.3 4.2-4.3 1.2 0 2.2.1 2.5.1v2.9h-1.7c-1.4 0-1.6.6-1.6 1.6v2.1h3.2l-.4 3.6h-2.8V24H23c.6 0 1-.4 1-1V1c0-.6-.4-1-1-1z"/>
            </svg>
          </a>
        </div>

        <!-- Links -->
        <div class="flex gap-4 md:gap-6 flex-wrap justify-center text-xs md:text-sm text-slate-600">
          <a href="#" class="hover:text-slate-900">Accueil</a>
          <a href="#" class="hover:text-slate-900">Dico</a>
          <a href="#" class="hover:text-slate-900">Arcade</a>
          <a href="#" class="hover:text-slate-900">Progrès</a>
          <a href="#" class="hover:text-slate-900">Profil</a>
        </div>

        <!-- Contact Info -->
        <div class="text-xs text-slate-500 text-center">
          <p>handdy@gmail.com</p>
          <p>Mentions légales · 23200 Montluçon</p>
        </div>
      </div>
    </div>
  </footer>
</div>
