---
export interface Props {
  title: string;
  image: string;
  description: string;
  videoUrl: string;
}

const { title, image, description, videoUrl } = Astro.props;
---

<div class="sign-card bg-white border border-gray-200 rounded-[1.5rem] shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col" data-video-url={videoUrl} data-sign-title={title}>
  
  <!-- Zone image / miniature cliquable pour lancer la vidéo -->
  <div class="relative aspect-[4/3] bg-black group cursor-pointer video-overlay-btn">
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-400">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
    )}
    
    <!-- Bouton Play géant au survol -->
    <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
       <svg class="w-16 h-16 text-white ml-2 drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </div>
  </div>

  <!-- Contenu texte et actions -->
  <div class="p-5 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold text-gray-900 capitalize font-cal-sans">{title}</h3>
      <p class="text-sm text-gray-500 mt-1 font-alexandria line-clamp-1">{description}</p>
    </div>
    
    <!-- Ligne de l'icône de téléchargement -->
    <div class="mt-4 flex justify-end items-center border-t border-gray-100 pt-4">
      <a href={videoUrl} target="_blank" download={`${title}.mp4`} class="p-2 rounded-full border border-gray-200 text-gray-500 hover:bg-gray-100 hover:text-black transition-colors" title="Télécharger la vidéo">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
      </a>
    </div>
  </div>
</div>