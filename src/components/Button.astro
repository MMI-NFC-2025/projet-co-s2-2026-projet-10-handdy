---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string; // C'est ici !
}

// AJOUTE 'id' dans cette ligne ci-dessous :
const { id, href, variant = 'primary', type = 'button', class: className = '' } = Astro.props;

// Définition des styles de base
const baseClasses = "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition duration-200 focus:outline-none focus:ring-2";

// ... (le reste de ton code ne change pas)
const variants = {
  primary: 'bg-[#FF6200] text-white hover:bg-orange-600 shadow-lg shadow-[#ff620033] focus:ring-[#FF6200]/40',
  secondary: 'bg-black text-white hover:bg-slate-900 focus:ring-slate-500/40',
  ghost: 'bg-white/10 text-black hover:bg-slate-900/10 border border-black/10 focus:ring-black/20',
};
---

{href ? (
  <a 
    href={href} 
    id={id} 
    class:list={[baseClasses, variants[variant] || variants.primary, className]}
  >
    <slot />
  </a>
) : (
  <button 
    type={type} 
    id={id} 
    class:list={[baseClasses, variants[variant] || variants.primary, className]}
  >
    <slot />
  </button>
)}