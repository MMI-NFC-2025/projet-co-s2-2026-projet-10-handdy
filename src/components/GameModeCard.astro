---
/**
 * GameModeCard Component (Style Héroïque)
 */

interface Props {
  title: string;
  description: string;
  icon?: string;
  badge?: string;
  onClick?: string;
}

const { title, description, icon, badge, onClick } = Astro.props;
---

<div 
  class="flex flex-col items-center justify-center gap-6 rounded-[32px]px-8 py-16 md:px-12 md:py-20 rounded-3xl text-center text-black shadow-2xl w-full"
  onclick={onClick}
>
  {icon && (
    <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-[#FF6200] mb-2">
      <img src={icon} alt={title} class="w-14 h-14 md:w-16 md:h-16 object-contain" />
    </div>
  )}
  
  <div class="max-w-xl">
    <h3 class="text-3xl md:text-4xl font-bold mb-4">{title}</h3>
    <p class="text-lg md:text-xl text-black leading-relaxed">
      {description}
    </p>
  </div>
  
  {badge && (
    <span class="inline-block bg-white/20 text-black px-6 py-2 rounded-full font-semibold text-sm tracking-wide uppercase">
      {badge}
    </span>
  )}
</div>