---
import Button from './Button.astro';
import heroPhone from '../assets/mode_arcade_landing_page.svg';
import parcoursImage from '../assets/parcour_utilisateur_landing_page.svg';
import wavesBig from '../assets/vagues_grandes.svg';
import wavesSmall from '../assets/vagues_petites.svg';
import logo from '../assets/logo_wendy.svg';

// Import de TOUTES tes nouvelles icônes
import iconBook from '../assets/bookopen.svg';
import iconGamepad from '../assets/gamepad2.svg';
import mascotte from '../assets/mascotte.svg';
import iconCartes from '../assets/cartes1.svg';
import iconMemory from '../assets/div.svg';
import iconVraiFaux from '../assets/vraifaux1.svg';
import iconCamera from '../assets/camera.svg';
import iconWifiOff from '../assets/wifioff.svg';
---

<main class="min-h-screen bg-white text-slate-950 font-sans overflow-x-hidden">
  
  <!-- En-tête : Logo et Bouton -->
  <nav class="relative z-50 w-full bg-white flex items-center justify-between py-6 px-6 md:px-12 max-w-[1440px] mx-auto">
    <img src={logo.src} alt="Wenddy Logo" class="h-12 md:h-16 w-auto" />
    <Button 
      href="#play" 
      variant="secondary" 
      class="bg-black text-white rounded-full px-8 py-3 md:py-4 text-sm md:text-xl font-bold hover:bg-slate-800 transition whitespace-nowrap"
    >
      Commencer à jouer !
    </Button>
  </nav>

  <!-- Hero Section -->
  <section class="relative bg-[#FF6200] overflow-hidden w-full flex items-center min-h-[600px] md:h-[750px]">
    <img src={wavesBig.src} alt="" class="absolute right-0 top-0 h-full w-auto object-cover object-left pointer-events-none hidden md:block" />

    <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center h-full">
      <div class="w-full md:w-[60%] pt-12 pb-8 md:py-0">
        <h1 class="text-4xl md:text-5xl lg:text-[64px] leading-[1.1] font-black text-white mb-6 font-cal-sans">
          Apprendre la langue des<br class="hidden lg:block"/> signes différemment !
        </h1>
        <p class="text-lg md:text-2xl text-white font-medium leading-relaxed max-w-xl font-alexandria">
          Mini-jeux, défis multijoueurs et progression fun pour maîtriser la langue des signes française
        </p>
      </div>

      <div class="w-full md:w-[40%] h-[400px] md:h-full relative mt-8 md:mt-0 flex justify-center md:block">
        <img src={parcoursImage.src} alt="Parcours" class="absolute z-10 w-[160px] md:w-[240px] drop-shadow-2xl transform -rotate-[7deg] right-[45%] md:right-[55%] top-[10%] md:top-[25%]" />
        <img src={heroPhone.src} alt="Mode arcade" class="absolute z-20 w-[150px] md:w-[220px] drop-shadow-2xl transform rotate-[12deg] right-[15%] md:right-[15%] top-[25%] md:top-[40%]" />
      </div>
    </div>
  </section>

  <!-- Section: Cartes de Mode (Même hauteur garantie avec tes icônes) -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-stretch">
      
      <!-- Carte Mode Entraînement -->
      <div class="h-full flex flex-col bg-[#FF6200] text-white p-8 md:p-12 rounded-[2rem] shadow-xl transform hover:-translate-y-2 transition duration-300">
        <!-- Boîte noire avec l'icône Livre -->
        <div class="mb-6 md:mb-8 inline-flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-3xl bg-black shadow-md">
          <img src={iconBook.src} alt="Livre" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
        </div>
        
        <h2 class="text-2xl font-bold mb-4 font-cal-sans">Mode Entraînement</h2>
        <p class="mb-8 font-medium font-alexandria text-lg">Un parcours pédagogique par paliers thématiques</p>
        
        <ul class="mt-auto space-y-3 text-sm opacity-90 list-disc list-inside font-alexandria">
          <li>Mini-jeux éducatifs (Memory, Cards, QCM)</li>
          <li>Système de vies et streak</li>
          <li>Mode hors ligne disponible</li>
        </ul>
      </div>

      <!-- Carte Mode Arcade -->
      <div class="h-full flex flex-col bg-[#FF6200] text-white p-8 md:p-12 rounded-[2rem] shadow-xl transform hover:-translate-y-2 transition duration-300">
        <!-- Boîte noire avec l'icône Manette -->
        <div class="mb-6 md:mb-8 inline-flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-3xl bg-black shadow-md">
          <img src={iconGamepad.src} alt="Manette" class="w-8 h-8 md:w-10 md:h-10 object-contain" />
        </div>
        
        <h2 class="text-2xl font-bold mb-4 font-cal-sans">Mode Arcade</h2>
        <p class="mb-8 font-medium font-alexandria text-lg">Action et compétition !<br/>Joue en solo ou en multijoueur.</p>
        
        <ul class="mt-auto space-y-3 text-sm opacity-90 list-disc list-inside font-alexandria">
          <li>Mini-jeux dynamiques et compétitifs</li>
          <li>Mode Battle multijoueur en temps réel</li>
          <li>Classements et scores</li>
          <li>Éliminations progressives</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- Diviseur Raton Laveur -->
  <div class="flex items-center justify-center gap-4 md:gap-8 my-8 px-6">
    <img src={mascotte.src} alt="Mascotte Wenddy" class="w-16 h-16 md:w-20 md:h-20 transform -scale-x-100 object-contain" />
    <div class="bg-black text-white font-bold py-4 px-8 md:px-16 rounded-full text-xl md:text-3xl text-center shadow-lg font-cal-sans whitespace-nowrap">
      3 mini-jeux variés
    </div>
    <img src={mascotte.src} alt="Mascotte Wenddy" class="w-16 h-16 md:w-20 md:h-20 object-contain" />
  </div>

  <!-- Section: Les 3 Mini-Jeux -->
  <section id="play" class="max-w-5xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10">
      
      <div class="bg-[#FF6200] text-white p-8 rounded-[1.5rem] flex flex-col items-center justify-center text-center shadow-md transform hover:scale-105 transition min-h-[200px]">
        <img src={iconCartes.src} alt="Cards" class="h-20 w-20 mx-auto mb-4 object-contain" />
        <h3 class="font-bold mb-2 text-xl font-cal-sans">Cards</h3>
        <p class="text-xs font-medium font-alexandria">Associe les bonnes cartes</p>
      </div>

      <div class="bg-[#FF6200] text-white p-8 rounded-[1.5rem] flex flex-col items-center justify-center text-center shadow-md transform hover:scale-105 transition min-h-[200px]">
        <!-- Le 'transform scale-150' zoome l'image pour compenser le vide autour du cerveau -->
        <img src={iconMemory.src} alt="Memory" class="h-20 w-20 mx-auto mb-4 object-contain transform scale-150" />
        <h3 class="font-bold mb-2 text-xl font-cal-sans">Memory</h3>
        <p class="text-xs font-medium font-alexandria">Associe mots et signes</p>
      </div>

      <div class="bg-[#FF6200] text-white p-8 rounded-[1.5rem] flex flex-col items-center justify-center text-center shadow-md transform hover:scale-105 transition min-h-[200px]">
        <img src={iconVraiFaux.src} alt="Vrai/Faux" class="h-20 w-20 mx-auto mb-4 object-contain" />
        <h3 class="font-bold mb-2 text-xl font-cal-sans">Vrai/Faux</h3>
        <p class="text-xs font-medium font-alexandria">Réponds rapidement</p>
      </div>

    </div>
  </section>
  <!-- Section: Fonctionnalités Uniques -->
  <section id="features" class="py-16 md:py-24 overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-6 mb-12">
      <h2 class="text-4xl md:text-5xl lg:text-[64px] font-black text-center font-cal-sans text-slate-950">Fonctionnalités uniques</h2>
    </div>
    
    <div class="relative w-full">
      <div class="bg-[#FF6200] py-24 px-6 relative overflow-hidden rounded-[3rem] md:rounded-[6rem] mx-4 md:mx-12" style="min-height: 500px;">
        
        <img src={wavesSmall.src} alt="" class="pointer-events-none absolute left-[-100px] bottom-[-50px] opacity-40 transform scale-x-[-1] scale-y-[-1] w-[500px]" />
        <img src={wavesSmall.src} alt="" class="pointer-events-none absolute right-0 top-0 opacity-40 w-[400px]" />

        <div class="absolute inset-0 flex flex-col md:flex-row items-center justify-center gap-12 md:gap-24 px-6 z-10">
          
          <!-- Rond 1: Miroir -->
          <div class="bg-white text-black p-8 rounded-full w-64 h-64 md:w-[320px] md:h-[320px] flex flex-col items-center justify-center text-center shadow-2xl transform hover:scale-105 transition">
            <div class="mb-4">
              <!-- Icône Appareil Photo / Miroir -->
              <img src={iconCamera.src} alt="Miroir" class="w-12 h-12 md:w-16 md:h-16 object-contain" />
            </div>
            <h3 class="font-bold text-lg md:text-xl mb-3 font-cal-sans">Miroir Interactif</h3>
            <p class="text-xs md:text-sm text-gray-800 px-6 font-alexandria font-medium leading-relaxed">
              Compare tes gestes avec le modèle en temps réel via ta caméra
            </p>
          </div>

          <!-- Rond 2: Hors Ligne -->
          <div class="bg-white text-black p-8 rounded-full w-64 h-64 md:w-[320px] md:h-[320px] flex flex-col items-center justify-center text-center shadow-2xl transform hover:scale-105 transition">
            <div class="mb-4">
              <!-- Icône Nuage / Wifi Off -->
              <img src={iconWifiOff.src} alt="Hors Ligne" class="w-12 h-12 md:w-16 md:h-16 object-contain" />
            </div>
            <h3 class="font-bold text-lg md:text-xl mb-3 font-cal-sans">Mode Hors Ligne</h3>
            <p class="text-xs md:text-sm text-gray-800 px-6 font-alexandria font-medium leading-relaxed">
              Télécharge des packs de leçons pour apprendre partout facilement
            </p>
          </div>
          
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section Footer -->
  <section class="max-w-7xl mx-auto px-6 py-16 mb-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
      <div class="flex-1 text-center md:text-left">
        <img src={logo.src} alt="Wenddy Logo" class="h-12 md:h-16 w-auto mb-6 mx-auto md:mx-0" />
        <h2 class="text-4xl md:text-5xl lg:text-[64px] font-black text-slate-950 font-cal-sans leading-tight">Prêt à maîtriser la LSF ?</h2>
      </div>
      
      <div class="flex-1 w-full">
        <!-- Conteneur du formulaire -->
        <div class="bg-slate-950 rounded-[28px] px-8 py-10 shadow-2xl transition-all duration-500" id="newsletter-container">
          
          <p id="newsletter-text" class="text-white text-base md:text-lg mb-6 font-medium font-alexandria text-center md:text-left">
            Rejoins la communauté Wenddy et commence ton aventure dès aujourd'hui !
          </p>
          
          <!-- Le Formulaire -->
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-4">
            <input 
              type="email" 
              id="newsletter-email"
              required
              placeholder="Ton email" 
              class="flex-1 rounded-full border-none bg-white px-6 py-4 text-slate-950 placeholder:text-slate-500 focus:outline-none focus:ring-4 focus:ring-[#FF6200] font-alexandria" 
            />
            <Button type="submit" class="bg-[#FF6200] hover:bg-orange-600 text-white rounded-full px-8 py-4 font-bold transition transform hover:scale-105 shadow-md border-none whitespace-nowrap">
              Commencer
            </Button>
          </form>

          <!-- Le Message de succès (Caché par défaut) -->
          <div id="newsletter-success" class="hidden text-center md:text-left">
            <div class="text-[#FF6200] text-4xl mb-2">✅</div>
            <h3 class="text-xl font-bold text-white font-cal-sans">Inscription validée !</h3>
            <p class="text-white/80 font-alexandria mt-2">Merci de nous avoir rejoints. Prépare-toi à découvrir la LSF différemment !</p>
          </div>
          
        </div>
      </div>
    </div>
  </section>

</main>
<script>
  // On attend que la page soit bien chargée
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('newsletter-form');
    const emailInput = document.getElementById('newsletter-email');
    const successMsg = document.getElementById('newsletter-success');
    const textMsg = document.getElementById('newsletter-text');

    if (form) {
      form.addEventListener('submit', (e) => {
        // Empêche la page de se rafraîchir
        e.preventDefault();
        
        // Vérifie qu'il y a bien quelque chose dans l'input
        if (emailInput && (emailInput as HTMLInputElement).value) {
          // Animation fictive : on cache le formulaire et on affiche le succès
          form.style.display = 'none';
          if (textMsg) textMsg.style.display = 'none';
          
          if (successMsg) {
            successMsg.classList.remove('hidden');
            // Optionnel : petite animation d'apparition
            successMsg.classList.add('animate-fade-in'); 
          }
        }
      });
    }
  });
</script>