<footer class="bg-[#F3F4F6] border-t border-gray-200 mt-12 md:mt-16">
  <div class="max-w-6xl mx-auto px-6 py-10">
    
    <!-- Ligne principale : Logo + Réseaux -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8">
      
      <!-- Logo -->
     <a href="/accueil" title="Retour à l'accueil" class="hover:opacity-80 transition">
        <img src="/icons/logo_wendy.svg" alt="Wenddy" class="h-12 w-auto" />
      </a>
      
      <!-- Réseaux sociaux -->
      <div class="flex gap-5 items-center">
        <a href="#" title="Facebook" class="text-gray-700 hover:text-[#FF6200] transition">
          <img src="/icons/icon_facebook.svg" alt="Facebook" class="w-6 h-6" />
        </a>
        <a href="#" title="Instagram" class="text-gray-700 hover:text-[#FF6200] transition">
          <img src="/icons/icon_instagram.svg" alt="Instagram" class="w-6 h-6" />
        </a>
        <a href="#" title="TikTok" class="text-gray-700 hover:text-[#FF6200] transition">
          <img src="/icons/icon_tiktok.svg" alt="TikTok" class="w-6 h-6" />
        </a>
        <a href="#" title="YouTube" class="text-gray-700 hover:text-[#FF6200] transition">
          <img src="/icons/icon_youtube.svg" alt="YouTube" class="w-6 h-6" />
        </a>
      </div>
    </div>

    <!-- Navigation -->
    <div class="flex flex-wrap gap-x-8 gap-y-2 mb-8">
      <a href="/apropos" class="text-gray-700 hover:text-[#FF6200] transition font-medium">A propos</a>
      <a href="/contact" class="text-gray-700 hover:text-[#FF6200] transition font-medium">Contact</a>
      <a href="/profil" class="text-gray-700 hover:text-[#FF6200] transition font-medium">Profil</a>
      <a href="/dico" class="text-gray-700 hover:text-[#FF6200] transition font-medium">Dico</a>
      <a href="/arcade" class="text-gray-700 hover:text-[#FF6200] transition font-medium">Arcade</a>
      
    </div>

    <!-- Séparateur -->
    <div class="border-t border-gray-200 pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-sm text-gray-500">
      <a href="mailto:contact@wenddy.fr" class="hover:text-[#FF6200] transition">contact@wenddy.fr</a>
      <a href="/mentionslegales" class="hover:text-[#FF6200] transition">Mentions légales</a>
      <span>25200 Montbéliard</span>
    </div>

  </div>
</footer>