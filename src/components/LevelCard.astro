---
/**
 * LevelCard Component
 * Affiche le niveau actuel avec barre de progression
 */

interface Props {
  level: number;
  currentXP: number;
  maxXP: number;
  icon?: string;
  avatar?: string;
}

const {
  level,
  currentXP,
  maxXP,
  icon = '/icons/bonhomme_chemin.svg',
  avatar
} = Astro.props;

const progressPercentage = (currentXP / maxXP) * 100;
---

<div class="bg-white rounded-3xl p-6 md:p-8 shadow-md">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <!-- Avatar Profil -->
      <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-slate-200 flex items-center justify-center overflow-hidden flex-shrink-0">
        {avatar ? (
          <img 
            src={avatar} 
            alt="Avatar utilisateur" 
            class="w-full h-full object-cover"
          />
        ) : (
          <svg class="w-8 h-8 md:w-10 md:h-10 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        )}
      </div>
      <div>
        <h3 class="text-lg md:text-xl font-semibold text-slate-900">Niveau {level}</h3>
        <p class="text-sm text-slate-600">{currentXP} / {maxXP} RC</p>
      </div>
    </div>
    
    <!-- Level Badge -->
    <div class="flex items-center justify-center w-16 h-16 md:w-20 md:h-20 bg-orange-500 rounded-full">
      <span class="text-white font-bold text-2xl md:text-3xl">{level}</span>
    </div>
  </div>
  
  <!-- Progress Bar -->
  <div class="w-full bg-slate-200 rounded-full h-3 md:h-4 overflow-hidden">
    <div
      class="bg-orange-500 h-full transition-all duration-500 ease-out"
      style={`width: ${Math.min(progressPercentage, 100)}%`}
    />
  </div>
</div>
